# --auto 로 자동 로그인할 때만 필요하다. 기본(수동 로그인)에는 필요 없다.
# 이 파일을 .env 로 복사해서 채운다. .env 는 커밋되지 않는다.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# --- 릴스 생성 ---
REELS_WATCH_DIR=G:\내 드라이브\릴스
REELS_SECONDS_PER_PHOTO=3

# --- Graph API 게시 (완전 자동에 필요) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# out/ 영상을 공개로 올려둔 곳. 없으면 게시는 건너뛴다.
REELS_PUBLIC_BASE=

# --- 내 업종에 맞추기 (post_text.py) ---
# 기본값은 교육·강의 계정 기준이다. 업종이 다르면 반드시 바꿔라.
# 안 바꾸면 카페 릴스에 #코딩교육 이 붙는다.
# CTA 는 | 로 여러 개를 적으면 그중 하나가 쓰인다.
REELS_CTA=
REELS_DEFAULT_TAGS=
# 키워드→해시태그 사전 / 자동 자막 문구. 각각 .example.txt 를 복사해서 쓴다.
REELS_TAG_RULES=tag_rules.txt
REELS_CAPTION_POOL=caption_pool.txt

# --- 배경음악 (audio_mix.py) ---
# 저작권 문제 없는 음원만 넣어라. 인스타 음원 라이브러리는 API 로 못 쓴다.
REELS_MUSIC_DIR=assets/music
REELS_MUSIC_FILE=assets/music/background.mp3
REELS_MUSIC_VOLUME=0.15
REELS_ORIGINAL_AUDIO_VOLUME=1.0
REELS_FADE_OUT_SECONDS=2
REELS_LOOP_MUSIC=true

# --- 초상권 안전장치 (face_guard.py) ---
# exclude = 식별되는 정면 얼굴이 있으면 제외 (기본) / blur = 모자이크 / off = 검사 안 함
REELS_FACE_POLICY=exclude
REELS_FACE_MAX_RATIO=0.04
REELS_FACE_PROFILE_YAW=0.35
REELS_FACE_ABSOLUTE_MAX_RATIO=0.07
REELS_FONT_SIZE=96
REELS_CAPTION_CHARS=11

# serve.py 가 실행될 때마다 자동으로 채운다. 직접 쓸 필요 없다.
# 고정 주소(S3/R2 등)를 쓰려면 여기에 직접 넣어라.
